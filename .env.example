# ── API UNIFICADA — variables de entorno ──
# Base de datos Supabase (Postgres) — OBLIGATORIO (la misma de los 3 servicios)
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Google Maps — rutas de reparto (Logística). Opcional si no se usa /sheets/maps.
GOOGLE_MAPS_API_KEY=

# Supabase Storage — fotos de supervisor / entregas (módulo gestión). Opcional.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Puerto — en Render se asigna automáticamente; local usa 3000.
PORT=3000

# Llamada interna a las rutas /sheets (gestión → /data/sedes). Por defecto el server
# lo apunta al self (http://localhost:PORT/sheets). Dejar vacío salvo caso especial.
# SHEETS_API_URL=

# Cachés en memoria (ms) — opcionales.
# DB_CACHE_TTL_MS=60000
# SHEET_CACHE_TTL_MS=300000

# NOTA: el service account de Google (ffvv-realzza-campo-07c3f6b5b98f.json) NO es una
# variable: es un archivo. En local debe estar en esta carpeta; en Render se sube como
# "Secret File" con ese mismo nombre.
